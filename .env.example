# Copy to `.env` on the host and fill in real values. `.env` is git-ignored and
# must stay that way — it holds the Parcel API key. Nothing secret is baked into
# the image; the key is injected at runtime.

# --- Image / deploy (read by docker-compose.yml) ---
IMAGE=ghcr.io/jb09/parcel-api-mcp:latest
CONTAINER_NAME=parcel-mcp
# External Docker network shared with your authorization proxy (e.g. Pomerium).
PROXY_NETWORK=pomerium

# --- Parcel API ---
# Base URL for Parcel's external API. All endpoints (deliveries, add-delivery,
# supported_carriers.json) are derived from it; override only for a test double.
PARCEL_API_BASE=https://api.parcel.app/external
# Personal API key generated in the Parcel web app (https://web.parcelapp.net ->
# Account -> API). Parcel rate-limits this key to 20 requests/hour. Required for
# the delivery read/write tools; the supported-carriers list is public.
PARCEL_API_KEY=your-parcel-api-key

# --- Query behavior ---
# Filter used when get_deliveries omits `filter_mode`: "active" (in-progress
# shipments only) or "recent" (also includes recently delivered). Note Parcel's
# own API default is "recent"; "active" is the sensible default for a briefing.
DEFAULT_FILTER_MODE=active
# Set to `true` to disable the add_delivery tool (the read tools still work), so a
# misused tool cannot add shipments to your Parcel account.
READ_ONLY=false
# Per-request network timeout (seconds). Keep it well below the fronting proxy's
# gateway timeout so a slow upstream returns a clean tool error, not a proxy 502.
PARCEL_TIMEOUT=15

# --- Startup self-test ---
# Set to `true` to call the Parcel API and count active deliveries when the server
# starts, verifying the configuration. On failure the reason is logged (auth /
# connection / API error) and the server keeps running.
STARTUP_TEST=false

# --- App-layer auth (defense in depth) ---
# The external authorization proxy is ALWAYS required. Set this to `true` to ALSO
# cryptographically verify Pomerium's identity assertion on every /mcp request
# (signature + expiry + audience). This blocks anything on the shared Docker
# network from reaching the app directly, bypassing Pomerium.
#
# When true you MUST:
#   1. Set `pass_identity_headers: true` on the Pomerium route (see README) — else
#      Pomerium sends no header and every request is rejected.
#   2. Set POMERIUM_JWKS_URL and POMERIUM_AUDIENCE below.
REQUIRE_POMERIUM_IDENTITY=false
# Pomerium's JWKS endpoint (public keys for its signing key). Required when the
# gate is on; the server refuses to start without it.
# POMERIUM_JWKS_URL=https://parcel-mcp.example.com/.well-known/pomerium/jwks.json
# Expected `aud` claim — the route's host/URL. Verified when set (strongly recommended).
# POMERIUM_AUDIENCE=parcel-mcp.example.com
# Expected `iss` claim. Verified only when set.
# POMERIUM_ISSUER=
# Header(s) carrying the assertion JWT (comma-separated). Default covers MCP mode
# (x-pomerium-assertion) and the general header (x-pomerium-jwt-assertion).
# POMERIUM_IDENTITY_HEADER=x-pomerium-assertion,x-pomerium-jwt-assertion

# --- Server bind (rarely changed) ---
# HOST=0.0.0.0
# PORT=8080
